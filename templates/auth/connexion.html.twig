{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 480px;">
    <h1 class="h3 mb-4 text-center">Connexion</h1>

    {% if erreurs is not empty %}
    <div class="alert alert-danger">
        {% for erreur in erreurs %}<div>{{ erreur }}</div>{% endfor %}
    </div>
    {% endif %}

    <form method="post" action="index.php?page=auth&amp;action=connexion" class="card card-body shadow-sm">
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ valeurs.email }}" required>
        </div>
        <div class="mb-3">
            <label for="mot_de_passe" class="form-label">Mot de passe</label>
            <input type="password" id="mot_de_passe" name="mot_de_passe" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success w-100">Se connecter</button>
    </form>

    <p class="text-center mt-3">
        Pas encore de compte ? <a href="index.php?page=auth&amp;action=inscription">Inscrivez-vous</a>
    </p>
</section>
{% endblock %}
